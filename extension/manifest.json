{
  "manifest_version": 3,
  "name": "TerminalBridge — powered by Marusya",
  "version": "2.12.2",
  "description": "Терминальный мост для ИИ-чатов: выполнение команд на локальном ПК — powered by Marusya",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "contextMenus"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "*://chatgpt.com/*",
        "*://chat.openai.com/*",
        "*://claude.ai/*",
        "*://*.claude.ai/*",
        "*://arena.ai/*",
        "*://*.arena.ai/*",
        "*://lmarena.ai/*",
        "*://*.lmarena.ai/*",
        "*://alice.yandex.ru/*",
        "*://*.alice.yandex.ru/*",
        "*://gemini.google.com/*",
        "*://copilot.microsoft.com/*",
        "*://giga.chat/*",
        "*://*.giga.chat/*",
        "*://aistudio.google.com/*",
        "*://grok.com/*",
        "*://*.grok.com/*",
        "*://perplexity.ai/*",
        "*://*.perplexity.ai/*",
        "*://chat.deepseek.com/*",
        "*://chat.qwen.ai/*",
        "*://chat.mistral.ai/*",
        "*://google.com/*",
        "*://www.google.com/*",
        "*://google.ru/*",
        "*://www.google.ru/*"
      ],
      "js": [
        "ax-detector.js",
        "ax-core.js",
        "ax-view.js",
        "ax-panel.js",
        "ax-palette.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "TerminalBridge — powered by Marusya"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    {
      "resources": [
        "ax-ui.css",
        "content.css"
      ],
      "matches": [
        "*://chatgpt.com/*",
        "*://chat.openai.com/*",
        "*://claude.ai/*",
        "*://*.claude.ai/*",
        "*://arena.ai/*",
        "*://*.arena.ai/*",
        "*://lmarena.ai/*",
        "*://*.lmarena.ai/*",
        "*://alice.yandex.ru/*",
        "*://*.alice.yandex.ru/*",
        "*://gemini.google.com/*",
        "*://copilot.microsoft.com/*",
        "*://giga.chat/*",
        "*://*.giga.chat/*",
        "*://aistudio.google.com/*",
        "*://grok.com/*",
        "*://*.grok.com/*",
        "*://perplexity.ai/*",
        "*://*.perplexity.ai/*",
        "*://chat.deepseek.com/*",
        "*://chat.qwen.ai/*",
        "*://chat.mistral.ai/*",
        "*://google.com/*",
        "*://www.google.com/*",
        "*://google.ru/*",
        "*://www.google.ru/*"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "ai-execute-runner@arena.local",
      "strict_min_version": "109.0"
    }
  }
}
